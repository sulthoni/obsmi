    ] ;

    rr:predicateObjectMap [
        rr:predicate sdp:minLength-DSC ;
        rr:objectMap [ 
            rml:reference "str:LocalRepresentation/str:EnumerationFormat/@minLength" ;
            rr:datatype xsd:integer
        ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate sdp:maxLength-DSC ;
        rr:objectMap [ 
            rml:reference "str:LocalRepresentation/str:EnumerationFormat/@maxLength" ;
            rr:datatype xsd:integer
        ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate sdp:usesConceptualDomainDSC-CD ;
        rr:objectMap [ 
            rr:parentTriplesMap sdmx:ConceptualDomainMapping ;
            rr:joinCondition [
                rr:child "str:ConceptIdentity" ;
                rr:parent "@urn" ;
        ] ;
    ]] ;

    # LINK TO CODELIST
    rr:predicateObjectMap [
        rr:predicate sdp:takesValueFromDSC-CL ;
        rr:objectMap [ 
            rr:parentTriplesMap sdmx:CodeListMapping ;
            rr:joinCondition [
                rr:child "str:LocalRepresentation/str:Enumeration" ;
                rr:parent "@urn" ;
        ] ;
    ]] ;
    
    ## LINK TO DATA STRUCTURE
    rr:predicateObjectMap [
        rr:predicate sdp:usedByDSC-DS ;
        rr:objectMap [
            rr:parentTriplesMap sdmx:DataStructureMapping ;
            rr:joinCondition [
                rr:child "../../../@urn" ;
                rr:parent "@urn" ;
            ]
        ]
    ] .

