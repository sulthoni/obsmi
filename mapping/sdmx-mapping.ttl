#################################
### CONCEPTUAL DOMAIN MAPPING ###
#################################
sdmx:ConceptualDomainMappingSource
    rml:source "SDMX All Structures.xml" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "//message:Structures/str:ConceptSchemes/str:ConceptScheme/str:Concept" .

sdmx:ConceptualDomainMapping
    rml:logicalSource sdmx:ConceptualDomainMappingSource ;

    rr:subjectMap [
        rr:template "http://sdmx.org/concept/{@urn}" ;
        rr:class gsim-sum:ConceptualDomain ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasId-IA ;
        rr:objectMap [ rml:reference "@id" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasName-IA ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] .

########################
### CODELIST MAPPING ###
########################
sdmx:CodeListMappingSource
    rml:source "SDMX All Structures.xml" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "//message:Structures/str:Codelists/str:Codelist" .

sdmx:CodeListMapping
    rml:logicalSource sdmx:CodeListMappingSource ;

    rr:subjectMap [
        rr:template "http://sdmx.org/codelist/{@id}" ;
        rr:class gsim-sum:CodeList ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasId-IA ;
        rr:objectMap [ rml:reference "@urn" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasName-IA ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "com:Description/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hadDescription-IA ;
        rr:objectMap [ rml:reference "com:Description/text()" ] ;
    ] ;

    rr:predicateObjectMap [
    rr:predicate sdp:containsCL-CI;
    rr:objectMap [
        rr:parentTriplesMap sdmx:CodeItemMapping ;
        rr:joinCondition [
            rr:child "@id" ;
            rr:parent "../@id" ;
        ]
    ] ].

#########################
### CODE ITEM MAPPING ###
#########################
sdmx:CodeItemMappingSource
    rml:source "SDMX All Structures.xml" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "//message:Structures/str:Codelists/str:Codelist/str:Code" .

sdmx:CodeItemMapping
    rml:logicalSource sdmx:CodeItemMappingSource ;

    rr:subjectMap [
        rr:template "http://sdmx.org/code/{@urn}" ;
        rr:class gsim-sum:CodeItem ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasId-IA ;
        rr:objectMap [ rml:reference "@urn" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasName-IA ;
        rr:objectMap [ rml:reference "com:Name/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "com:Description/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hadDescription-IA ;
        rr:objectMap [ rml:reference "com:Description/text()" ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsim-sum:hasValue-IA ;
        rr:objectMap [ rml:reference "@id" ] ;
    ] .