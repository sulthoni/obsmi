mappingId	mapping--351010139
target		colsys:core-output/{s_id}/{sp_id}/create-sample-frame-and-select-sample a :CoreOutput ; :refersToCO-IA colsys:data-structure/sample-output-columns/{somc_id} , colsys:dataset/sample-output/{som_id} . 
source		SELECT 
			      s.id s_id,
			      s.name s_name,
			      s.description s_description,
			      s.survey_sample_method_id s_survey_sample_method_id,
			      sp.id sp_id,
			      sm.id sm_id,
			      sm.name sm_name,
			      sm.sample_input_script_id sm_sample_input_script_id,
			      sm.sample_stratify_level_id sm_sample_stratify_level_id,
			      sm.r_method sm_r_method,
			      sm.total_output sm_total_output,
			      sm.user_id sm_user_id,
			      sm.is_active sm_is_active,
			      sm.created_at sm_created_at,
			      sm.updated_at sm_updated_at,
			      som.id som_id,
			      som.name som_name,
			      som.order_output_map som_order_output_map,
			      somp.id somp_id,
			      somp.source_survey_period_id somp_source_survey_period_id,
			      somp.target_survey_period_id somp_target_survey_period_id,
			      soc.id soc_id,
			      soc.field soc_field,
			      soc.entity soc_entity,
			      soc.alias soc_alias,
			      soc.data_output_column soc_data_output_column,
			      soc.order_output_column soc_order_output_column,
			      somc.id somc_id,
			      somc.field somc_field,
			      somc.entity somc_entity,
			      somc.alias somc_alias,
			      somc.order_output_main_column somc_order_output_main_column
			    FROM 
			      survey.surveys s JOIN survey.survey_periods sp ON s.id = sp.survey_id 
			      JOIN sample.sample_methods sm ON s.survey_sample_method_id = sm.id
			      JOIN sample.sample_output_maps som ON sm.id = som.sample_method_id 
			      JOIN sample.sample_output_columns soc ON soc.sample_output_map_id = som.id 
			      JOIN sample.sample_output_map_periods somp ON somp.sample_output_map_id = som.id 
			      JOIN sample.sample_output_main_columns somc ON somc.id = soc.sample_output_main_column_id

mappingId	mapping--252823709
target		colsys:core-output/{s_id}/{sp_id}/build-collection-instrument a :CoreOutput ; gsim-sum:hasName-IA "Core Output - Build Collection Instrument - {s_name} periode {sp_name}"^^xsd:string ; rdfs:label "Core Output - Build Collection Instrument - {s_name} periode {sp_name}"^^xsd:string . 
source		Select
			          s.id s_id,
			          s.unit s_unit,
			          s.name s_name,
			          s.description s_description,
			          s.program_id s_program_id,
			          s.user_id s_user_id,
			          s.is_active s_is_active,
			          s.panel_type s_panel_type,
			          s.area_type s_area_type,
			          s.update_listing_type s_update_listing_type,
			          s.can_add_sample s_can_add_sample,
			          s.is_multi_pencacah s_is_multi_pencacah,
			          s.geo_live_tracking s_geo_live_tracking,
			          s.geo_radius s_geo_radius,
			          s.geo_accuracy s_geo_accuracy,
			          s.survey_sample_method_id s_survey_sample_method_id,
			          s.survey_step_type_id s_survey_step_type_id,
			          s.survey_parent_id s_survey_parent_id,
			          s.cawi_token_auto_generated s_cawi_token_auto_generated,
			          s.html s_html,
			          s.html_email s_html_email,
			          s.image_service_type s_image_service_type,
			          s.image_service_url s_image_service_url,
			          s.created_at s_created_at,
			          s.updated_at s_updated_at,
			          s.region_group_id s_region_group_id,
			          s.survey_type s_survey_type,
			          s.background_record s_background_record,
			          s.smallest_region_type s_smallest_region_type,
			          s.ocawi_alias s_ocawi_alias,
			          s.cawi_authentication_link s_cawi_authentication_link,
			          s.papi_validation_type s_papi_validation_type,
			          s.collection_method s_collection_method,
			          s.path_offline_pdf_template s_path_offline_pdf_template,
			          s.type_role s_type_role,
			          s.show_cawi_receipt s_show_cawi_receipt,
			          s.cawi_max_access s_cawi_max_access,
			          s.html_received s_html_received,
			          s.form_gear_version s_form_gear_version,
			          s.html_rejection_email s_html_rejection_email,
			          s.auto_assign_when_upload_sample s_auto_assign_when_upload_sample,
			          sp.id sp_id,
			          sp.name sp_name,
			          sp.survey_id sp_survey_id,
			          sp.start_date sp_start_date,
			          sp.end_date sp_end_date,
			          sp.created_at sp_created_at,
			          sp.updated_at sp_updated_at,
			          sp.is_active sp_is_active,
			          sp.sample_method_id sp_sample_method_id,
			          sp.log sp_log
			          FROM
			          survey.surveys s INNER JOIN survey.survey_periods sp
			          ON s.id = sp.survey_id

