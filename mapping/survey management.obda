			    FROM
			      data_extraction.extraction_output_tables eot JOIN data_extraction.survey_period_extraction_templates spet ON eot.id = spet.extraction_output_table_id 
			      JOIN survey.survey_periods sp ON spet.survey_period_id = sp.id
			    WHERE spet.created_at IS NOT NULL) CHILD, (SELECT
			      eot.id eot_id,
			      eot.name eot_name,
			      spet.id spet_id,
