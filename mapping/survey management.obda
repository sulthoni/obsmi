mappingId	tm-join-1808695558
target		colsys:datastructure/finalise-data-files/{CHILD_et_id} :hasDS-DSC colsys:data-structure-component/finalise-data-files/table/{PARENT_etab_id} . 
source		SELECT CHILD.et_id AS CHILD_et_id, PARENT.etab_id AS PARENT_etab_id FROM (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      data_extraction.extraction_template et  
			      JOIN data_extraction.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN data_extraction.extraction_column ec ON etab.id = ec.extraction_table_id) CHILD, (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      data_extraction.extraction_template et  
			      JOIN data_extraction.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN data_extraction.extraction_column ec ON etab.id = ec.extraction_table_id) PARENT WHERE CHILD.et_id = PARENT.etab_extraction_template_id

mappingId	tm-join-1758114230
target		colsys:data-structure-component/finalise-data-files/table/{CHILD_etab_id} :hasDSC-DSC colsys:data-structure-component/finalise-data-files/column/{PARENT_ec_id} . 
source		SELECT CHILD.etab_id AS CHILD_etab_id, PARENT.ec_id AS PARENT_ec_id FROM (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
