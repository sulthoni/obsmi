[MappingDeclaration] @collection [[
mappingId	mapping-2071114218
target		colsys:datastructure/finalise-data-files/{et_id} a gsim-sum:DataStructure ; gsim-sum:hasName-IA "Data Structure - Finalise Data Files - Template ID: {et_template_id} - Version: {et_template_version} - Validation Version: {et_validation_version}"^^xsd:string . 
source		SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      data_extraction.extraction_template et  
			      JOIN data_extraction.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN data_extraction.extraction_column ec ON etab.id = ec.extraction_table_id

mappingId	mapping--982708374
target		<https://bps.go.id/metadata/software/integrated-collection-system/ics/role/{id}> a gsim:Role ; rdfs:label "Role - {name}"^^xsd:string . 
source		SELECT * FROM dbo.roles

mappingId	mapping--1024629244
target		colsys:process-step/{s_id}/{sp_id}/create-sample-frame-and-select-sample a :ProcessStep ; :hasPS-PI colsys:parameter-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample/{sic_id} , colsys:process-support-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample/{ssf_id} , colsys:parameter-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample/{sisrl_id} , colsys:parameter-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample/{simc_id} . 
source		SELECT 
			      s.id s_id,
			      s.name s_name,
			      s.description s_description,
			      s.survey_sample_method_id s_survey_sample_method_id,
			      sp.id sp_id,
			      sm.id sm_id,
			      sm.name sm_name,
			      sm.sample_input_script_id sm_sample_input_script_id,
			      sm.sample_stratify_level_id sm_sample_stratify_level_id,
			      sm.r_method sm_r_method,
			      sm.total_output sm_total_output,
			      sm.user_id sm_user_id,
			      sm.is_active sm_is_active,
			      sm.created_at sm_created_at,
			      sm.updated_at sm_updated_at,
			      sis.id sis_id,
			      sis.name sis_name,
			      sis.query_input sis_query_input,
			      sis.testing_input_survey_id sis_testing_input_survey_id,
			      sis.testing_input_survey_period_id sis_testing_input_survey_period_id,
			      ssf.id ssf_id,
			      ssf.name ssf_name,
			      ssf.file_path ssf_file_path,
			      ssf.created_at ssf_created_at,
			      ssf.updated_at ssf_updated_at,
			      sic.id sic_id,
			      sic.field sic_field,
			      sic.entity sic_entity,
			      sic.alias sic_alias,
			      sic.description sic_description,
			      sic.order_input_column sic_order_input_column,
			      ssl.id ssl_id,
			      ssl.name ssl_name,
			      ssl.info ssl_info,
			      sisrl.id sisrl_id,
			      sisrl.roster_name sisrl_roster_name,
			      sisrl.roster_level sisrl_roaster_level,
			      simc.id simc_id,
			      simc.field simc_field,
			      simc.entity simc_entity,
			      simc.alias simc_alias,
			      simc.description simc_description,
			      simc.order_input_master simc_order_input_master
			    FROM 
			      survey.surveys s JOIN survey.survey_periods sp ON s.id = sp.survey_id 
			      JOIN sample.sample_methods sm ON s.survey_sample_method_id = sm.id 
			      JOIN sample.sample_input_scripts sis ON sis.id = sm.sample_input_script_id 
			      JOIN sample.sample_input_columns sic ON sic.sample_input_script_id = sic.id 
			      JOIN sample.sample_support_files ssf ON sm.id = ssf.sample_method_id 
			      JOIN sample.sample_input_script_roster_levels sisrl ON sisrl.sample_input_script_id = sic.id 
			      JOIN sample.sample_stratify_levels ssl ON ssl.id = sm.sample_stratify_level_id 
			      JOIN sample.sample_input_master_columns simc ON simc.id = sic.sample_input_master_column_id

mappingId	mapping--25777248
target		colsys:data-structure-component/finalise-data-files/table/{etab_id} a gsim-sum:DataStructureComponent ; gsim-sum:hasDescription-IA "Roster Level: {etab_roster_level}"^^xsd:string ; gsim-sum:hasName-IA "Data Structure Component - Finalise Data Files - Table Name: {etab_name}"^^xsd:string . 
source		SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      data_extraction.extraction_template et  
			      JOIN data_extraction.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN data_extraction.extraction_column ec ON etab.id = ec.extraction_table_id

mappingId	mapping--1595855915
target		colsys:subject-field/finalise-data-file/{spett_id} a gsim-sum:SubjectField ; gsim-sum:hasName-IA "Subject Field - Finalise Data Files - Topic: {spett_topic}"^^xsd:string . 
source		SELECT
			      eot.id eot_id,
			      eot.name eot_name,
			      spet.id spet_id,
			      spet.survey_period_id spet_survey_period_id,
			      spet.template_id spet_template_id,
			      spet.extraction_output_table_id spet_extraction_output_table_id,
			      spet.created_by spet_created_by,
			      spet.created_at spet_created_at,
			      spet.is_active spet_is_active,
			      spett.id spett_id,
			      spett.survey_period_id spett_survey_period_id,
			      spett.template_id spett_template_id,
			      spett.extraction_table_id spett_extraction_table_id,
			      spett.extraction_output_table_id spett_extraction_output_table_id,
			      spett.topic spett_topic,
			      spett.created_by spett_created_by,
			      spett.created_at spett_created_at,
			      spett.is_active spett_is_active,
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      sp.survey_id s_id,
			      sp.id sp_id
			    FROM
			      data_extraction.extraction_output_tables eot JOIN data_extraction.survey_period_extraction_templates spet ON eot.id = spet.extraction_output_table_id 
			      JOIN data_extraction.survey_period_extraction_table_topics spett ON eot.id = spett.extraction_output_table_id 
			      JOIN data_extraction.extraction_template et ON spet.extraction_template_id  = et.id 
			      LEFT JOIN survey.survey_periods sp ON spet.survey_period_id = sp.id

mappingId	mapping--1130590908
target		colsys:core-output/{s_id}/{sp_id}/build-collection-instrument :refersToCO-IA colsys:agent-in-role/simitra-ics/{msi_id} . 
source		SELECT s.id s_id, sp.id sp_id, msi.id msi_id 
			        FROM survey.mapping_simitra_ics msi 
			        JOIN survey.surveys s ON msi.survey_id = s.id 
			        JOIN survey.survey_periods sp ON sp.survey_id = s.id

mappingId	mapping--728866809
target		colsys:process-execution-log/role-user-upload-log/{id} a :ProcessExecutionLog ; :updatedAt-IA {updated_at}^^xsd:dateTime ; :createdAt-IA {created_at}^^xsd:dateTime ; rdfs:label "Process Execution Log - user region {user_region_id} - file name {file_name} - status {status} - message {message}"^^xsd:string ; gsim-sum:hasName-IA "Process Execution Log - user region {user_region_id} - file name {file_name} - status {status} - message {message}"^^xsd:string . 
