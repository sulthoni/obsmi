			      spet.template_id spet_template_id,
			      spet.extraction_output_table_id spet_extraction_output_table_id,
			      spet.created_by spet_created_by,
			      spet.created_at spet_created_at,
			      spet.is_active spet_is_active,
			      spett.id spett_id,
			      spett.survey_period_id spett_survey_period_id,
			      spett.template_id spett_template_id,
			      spett.extraction_table_id spett_extraction_table_id,
			      spett.extraction_output_table_id spett_extraction_output_table_id,
			      spett.topic spett_topic,
			      spett.created_by spett_created_by,
			      spett.created_at spett_created_at,
			      spett.is_active spett_is_active,
