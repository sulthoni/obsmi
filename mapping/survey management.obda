			      JOIN data_extraction.extraction_template et ON spet.extraction_template_id  = et.id 
			      LEFT JOIN survey.survey_periods sp ON spet.survey_period_id = sp.id) PARENT WHERE CHILD.eot_id = PARENT.spet_extraction_output_table_id

