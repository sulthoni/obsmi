source		SELECT CHILD.s_id AS CHILD_s_id, CHILD.sp_id AS CHILD_sp_id, CHILD.eot_id AS CHILD_eot_id, PARENT.s_id AS PARENT_s_id, PARENT.sp_id AS PARENT_sp_id, PARENT.spet_id AS PARENT_spet_id FROM (SELECT
			      eot.id eot_id,
			      eot.name eot_name,
			      spet.id spet_id,
			      spet.survey_period_id spet_survey_period_id,
			      spet.template_id spet_template_id,
			      spet.template_version spet_template_version,
			      spet.validation_version spet_validation_version,
			      spet.extraction_template_id spet_extraction_template_id,
			      spet.count_added_table spet_count_added_table,
			      spet.count_deleted_table spet_count_deleted_table,
			      spet.count_added_column spet_count_added_column,
			      spet.count_deleted_column spet_count_deleted_column,
			      spet.count_changed_column spet_count_changed_column,
			      spet.extraction_output_table_id spet_extraction_output_table_id,
			      spet.created_by spet_created_by,
			      spet.created_at spet_created_at,
			      spet.is_active spet_is_active,
			      sp.survey_id s_id,
			      sp.id sp_id
			    FROM
			      data_extraction.extraction_output_tables eot JOIN data_extraction.survey_period_extraction_templates spet ON eot.id = spet.extraction_output_table_id 
			      JOIN survey.survey_periods sp ON spet.survey_period_id = sp.id
			    WHERE spet.created_at IS NOT NULL) CHILD, (SELECT
			      eot.id eot_id,
			      eot.name eot_name,
			      spet.id spet_id,
			      spet.survey_period_id spet_survey_period_id,
			      spet.template_id spet_template_id,
			      spet.template_version spet_template_version,
			      spet.validation_version spet_validation_version,
			      spet.extraction_template_id spet_extraction_template_id,
			      spet.count_added_table spet_count_added_table,
			      spet.count_deleted_table spet_count_deleted_table,
			      spet.count_added_column spet_count_added_column,
			      spet.count_deleted_column spet_count_deleted_column,
			      spet.count_changed_column spet_count_changed_column,
			      spet.extraction_output_table_id spet_extraction_output_table_id,
			      spet.created_by spet_created_by,
			      spet.created_at spet_created_at,
			      spet.is_active spet_is_active,
			      sp.survey_id s_id,
			      sp.id sp_id
			    FROM
			      data_extraction.extraction_output_tables eot JOIN data_extraction.survey_period_extraction_templates spet ON eot.id = spet.extraction_output_table_id 
