mappingId	mapping-688515852
target		colsys:core-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample a :CoreInput ; :refersToCI-IA colsys:level/sample/{ssl_id} , colsys:rule/sample/{sic_id} . 
source		SELECT 
			      s.id s_id,
			      s.name s_name,
			      s.description s_description,
			      s.survey_sample_method_id s_survey_sample_method_id,
			      sp.id sp_id,
			      sm.id sm_id,
			      sm.name sm_name,
			      sm.sample_input_script_id sm_sample_input_script_id,
			      sm.sample_stratify_level_id sm_sample_stratify_level_id,
			      sm.r_method sm_r_method,
			      sm.total_output sm_total_output,
			      sm.user_id sm_user_id,
			      sm.is_active sm_is_active,
			      sm.created_at sm_created_at,
			      sm.updated_at sm_updated_at,
			      sis.id sis_id,
			      sis.name sis_name,
			      sis.query_input sis_query_input,
			      sis.testing_input_survey_id sis_testing_input_survey_id,
			      sis.testing_input_survey_period_id sis_testing_input_survey_period_id,
			      ssf.id ssf_id,
			      ssf.name ssf_name,
			      ssf.file_path ssf_file_path,
			      ssf.created_at ssf_created_at,
			      ssf.updated_at ssf_updated_at,
			      sic.id sic_id,
			      sic.field sic_field,
			      sic.entity sic_entity,
			      sic.alias sic_alias,
			      sic.description sic_description,
			      sic.order_input_column sic_order_input_column,
			      ssl.id ssl_id,
			      ssl.name ssl_name,
			      ssl.info ssl_info,
			      sisrl.id sisrl_id,
			      sisrl.roster_name sisrl_roster_name,
			      sisrl.roster_level sisrl_roaster_level,
			      simc.id simc_id,
			      simc.field simc_field,
			      simc.entity simc_entity,
			      simc.alias simc_alias,
			      simc.description simc_description,
			      simc.order_input_master simc_order_input_master
			    FROM 
			      survey.surveys s JOIN survey.survey_periods sp ON s.id = sp.survey_id 
			      JOIN sample.sample_methods sm ON s.survey_sample_method_id = sm.id 
			      JOIN sample.sample_input_scripts sis ON sis.id = sm.sample_input_script_id 
			      JOIN sample.sample_input_columns sic ON sic.sample_input_script_id = sic.id 
			      JOIN sample.sample_support_files ssf ON sm.id = ssf.sample_method_id 
			      JOIN sample.sample_input_script_roster_levels sisrl ON sisrl.sample_input_script_id = sic.id 
			      JOIN sample.sample_stratify_levels ssl ON ssl.id = sm.sample_stratify_level_id 
			      JOIN sample.sample_input_master_columns simc ON simc.id = sic.sample_input_master_column_id

mappingId	mapping--2109296008
target		colsys:process-step/{s_id}/{sp_id}/create-sample-frame-and-select-sample a :ProcessStep ; :createsPS-PO colsys:core-output/{s_id}/{sp_id}/create-sample-frame-and-select-sample ; :classifiedAs-PS igsbpm:4.1 ; :hasPS-PI colsys:core-input/{s_id}/{sp_id}/create-sample-frame-and-select-sample ; gsim-sum:hasName-IA "Process Step - Create Sample Frame and Select Sample - {sm_name}"^^xsd:string ; :hasStartTime-PS {sm_created_at}^^xsd:dateTime . 
source		SELECT 
			        s.id s_id,
