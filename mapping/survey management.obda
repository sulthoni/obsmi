mappingId	mapping-1504616172
target		colsys:individual/{user_id} a gsim:Individual ; :hasTokenCode-I {token}^^xsd:string . 
source		SELECT * FROM dbo.user_tokens

mappingId	mapping-2134798928
target		<https://bps.go.id/metadata/software/integrated-collection-system/ics/service-definition/{sd_id}> a cspa:ServiceDefinition . 
