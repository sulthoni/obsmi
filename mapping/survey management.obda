mappingId	mapping-1531965927
target		<https://bps.go.id/metadata/subject-field/{id}> a gsim-sum:SubjectField ; :hasContextOfSP-SF colsys:statistical-program/{s_id} ; gsim-sum:hasName-IA {name}^^xsd:string ; gsim-sum:hasDescription-IA {description}^^xsd:string ; gsim-sum:hasId-IA {id}^^xsd:string ; :updatedAt-IA {updated_at}^^xsd:dateTime ; :createdAt-IA {created_at}^^xsd:dateTime ; rdfs:label {name}^^xsd:string . 
source		SELECT p.id id, p.name name, p.description description, p.created_at created_at, p.updated_at updated_at, s.id s_id
			        FROM survey.programs p 
			        JOIN survey.surveys s ON p.id = s.program_id

mappingId	mapping--1056759523
target		colsys:data-structure-component/finalise-data-files/column/{ec_id} a gsim-sum:DataStructureComponent ; gsim-sum:hasName-IA "Data Structure Component - Finalise Data Files - Column Name: {ec_name}"^^xsd:string ; gsim-sum:hasDescription-IA "Data Type: {ec_data_type}. From Template: {ec_from_template}. Is Primary Key: {ec_pk}."^^xsd:string . 
source		SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      data_extraction.extraction_template et  
			      JOIN data_extraction.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN data_extraction.extraction_column ec ON etab.id = ec.extraction_table_id

mappingId	mapping-582912031
target		colsys:process-step/{s_id}/{sp_id}/finalise-data-files/{eot_id} a :ProcessStep . 
source		SELECT
			      eot.id eot_id,
			      eot.name eot_name,
			      spet.id spet_id,
			      spet.survey_period_id spet_survey_period_id,
			      spet.template_id spet_template_id,
			      spet.template_version spet_template_version,
			      spet.validation_version spet_validation_version,
			      spet.extraction_template_id spet_extraction_template_id,
			      spet.count_added_table spet_count_added_table,
			      spet.count_deleted_table spet_count_deleted_table,
			      spet.count_added_column spet_count_added_column,
			      spet.count_deleted_column spet_count_deleted_column,
			      spet.count_changed_column spet_count_changed_column,
			      spet.extraction_output_table_id spet_extraction_output_table_id,
			      spet.created_by spet_created_by,
			      spet.created_at spet_created_at,
