[MappingDeclaration] @collection [[
mappingId	mapping--149314549
target		colsys:questionnaire/{t_id} a gsim:Questionnaire . 
source		SELECT
			          t.id t_id,
			          t.name t_name,
			          s.id s_id,
			          s.name s_name,
			          c.id c_id,
			          c.label c_label
			        FROM
			          designer.template t JOIN designer.[section] s ON t.id = s.template_id
			          JOIN designer.component c ON s.id = c.section_id

mappingId	mapping--704289520
target		<https://bps.go.id/metadata/software/questionnaire-designer/form-engine/agent-in-role/{id}> a gsim-sum:AgentInRole ; rdfs:label "Agent In Role - {user_id} - {role_id}"^^xsd:string . 
source		SELECT
			           'QuestionnaireDesigner' AS pkg_id, *
			          FROM dbo.user_roles

