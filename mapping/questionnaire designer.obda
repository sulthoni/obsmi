source		SELECT CHILD.id AS CHILD_id, PARENT.id AS PARENT_id FROM (SELECT * FROM designer.component) CHILD, (SELECT * FROM designer.question_type) PARENT WHERE CHILD.question_type_id = PARENT.id

mappingId	tm-join--54528467
target		colsys:question/{CHILD_id} :usesQu-CL colsys:code-list/lookup-data/{PARENT_id} . 
source		SELECT CHILD.id AS CHILD_id, PARENT.id AS PARENT_id FROM (SELECT * FROM designer.component) CHILD, (SELECT * FROM designer.lookup_data) PARENT WHERE CHILD.lookup_data_id = PARENT.id

mappingId	tm-join--1429698771
target		colsys:question/{CHILD_id} :hasValueDomainQu-VD colsys:value-domain/default-value/{PARENT_component_id} . 
source		SELECT CHILD.id AS CHILD_id, PARENT.component_id AS PARENT_component_id FROM (SELECT * FROM designer.component) CHILD, (SELECT * FROM designer.component_default_value) PARENT WHERE CHILD.id = PARENT.component_id

mappingId	tm-join-500695726
target		colsys:variable/{CHILD_variable_id} :usedbyV-QB colsys:question-block/{PARENT_id} . 
source		SELECT CHILD.variable_id AS CHILD_variable_id, PARENT.id AS PARENT_id FROM (SELECT * FROM designer.section_enabling_parameter) CHILD, (SELECT * FROM designer.section) PARENT WHERE CHILD.section_id = PARENT.id

mappingId	tm-join--1884262929
target		colsys:datastructure/design-collection/{CHILD_et_id} :hasDS-DSC colsys:data-structure-component/design-collection/table/{PARENT_etab_id} . 
source		SELECT CHILD.et_id AS CHILD_et_id, PARENT.etab_id AS PARENT_etab_id FROM (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      designer.extraction_template et  
			      JOIN designer.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN designer.extraction_column ec ON etab.id = ec.extraction_table_id) CHILD, (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      designer.extraction_template et  
			      JOIN designer.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN designer.extraction_column ec ON etab.id = ec.extraction_table_id) PARENT WHERE CHILD.et_id = PARENT.etab_extraction_template_id

mappingId	tm-join-730767383
target		<{CHILD_pkg_iri}> cspa:hasPackageDefinition <https://bps.go.id/metadata/software/questionnaire-designer/form-engine/service-definition/{PARENT_sd_id}> . 
source		SELECT CHILD.pkg_iri AS CHILD_pkg_iri, PARENT.sd_id AS PARENT_sd_id FROM (SELECT
			        'QuestionnaireDesigner' AS pkg_id,
			        'https://bps.go.id/metadata/software/questionnaire-designer/form-engine' AS pkg_iri) CHILD, (SELECT
			        'QuestionnaireDesigner' AS pkg_id,
			        'service-definition-1' AS sd_id) PARENT WHERE CHILD.pkg_id = PARENT.pkg_id

mappingId	tm-join--977818384
target		<{CHILD_pkg_iri}> cspa:hasPackageImplementation <https://bps.go.id/metadata/software/questionnaire-designer/form-engine/service-implementation/{PARENT_fe_id}/version/{PARENT_fer_version}> . 
source		SELECT CHILD.pkg_iri AS CHILD_pkg_iri, PARENT.fe_id AS PARENT_fe_id, PARENT.fer_version AS PARENT_fer_version FROM (SELECT
			        'QuestionnaireDesigner' AS pkg_id,
			        'https://bps.go.id/metadata/software/questionnaire-designer/form-engine' AS pkg_iri) CHILD, (SELECT
			        'QuestionnaireDesigner' AS pkg_id,
			        fe.id fe_id,
			        fe.name fe_name,
			        fe.description fe_description,
			        fe.brand_name fe_brand_name,
			        fe.file_name fe_file_name,
			        fer.id fer_id,
			        fer.form_engine_id fer_form_engine_id,
			        fer.version fer_version,
			        fer.base_path fer_base_path
			      FROM
			        designer.form_engine fe JOIN designer.form_engine_release fer ON fe.id = fer.form_engine_id) PARENT WHERE CHILD.pkg_id = PARENT.pkg_id

mappingId	tm-join--1793348528
target		colsys:process-execution-log/{CHILD_survey_id}/{CHILD_survey_periode_id}/design-collection :refinesPEL-PEL colsys:process-execution-log/template-history/{PARENT_id} . 
source		SELECT CHILD.survey_id AS CHILD_survey_id, CHILD.survey_periode_id AS CHILD_survey_periode_id, PARENT.id AS PARENT_id FROM (SELECT
			          st.survey_id survey_id,
			          sp.id survey_periode_id,
			          st.template_id questionnaire_id,
			          st.survey_template_name questionnaire_name,
			          st.template_version questionnaire_version,
			          st.validation_version validation_version,
			          st.created_at created_at,
			          st.updated_at updated_at,
			          h.id h_id
			      FROM 
			        survey.survey_templates st INNER JOIN survey.survey_periods sp ON st.survey_id = sp.survey_id
			        JOIN designer.history h ON st.template_id = h.template_id) CHILD, (SELECT * FROM designer.history) PARENT WHERE CHILD.h_id = PARENT.id

