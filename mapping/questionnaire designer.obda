target		colsys:value-domain/variable/{id} a gsim-sum:ValueDomain ; rdfs:label {key}^^xsd:string ; gsim-sum:hasName-IA {key}^^xsd:string ; gsim-sum:hasValue-IA {value}^^xsd:string . 
