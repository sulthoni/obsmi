mappingId	mapping-796246914
target		colsys:datastructure/design-collection/{et_id} a gsim-sum:DataStructure ; gsim-sum:hasName-IA "Data Structure - Design Collection - Template ID: {et_template_id} - Version: {et_template_version} - Validation Version: {et_validation_version}"^^xsd:string . 
source		SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      designer.extraction_template et  
			      JOIN designer.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN designer.extraction_column ec ON etab.id = ec.extraction_table_id

mappingId	mapping-1920521352
target		<{pkg_iri}> a cspa:Package ; cspa:description "Questionnaire Designer - Form Engine for survey data collection that capable to design and manage questionnaires effectively"^^xsd:string ; rdfs:label "Questionnaire Designer - Form Engine"^^xsd:string ; cspa:label "Questionnaire Designer - Form Engine"^^xsd:string . 
source		SELECT
			        'QuestionnaireDesigner' AS pkg_id,
			        'https://bps.go.id/metadata/software/questionnaire-designer/form-engine' AS pkg_iri

mappingId	mapping--1574434000
target		colsys:process-execution-log/{survey_id}/{survey_periode_id}/design-collection a :ProcessExecutionLog . 
source		SELECT
			          st.survey_id survey_id,
			          sp.id survey_periode_id,
			          st.template_id questionnaire_id,
			          st.survey_template_name questionnaire_name,
			          st.template_version questionnaire_version,
			          st.validation_version validation_version,
			          st.created_at created_at,
			          st.updated_at updated_at,
			          h.id h_id
			      FROM 
			        survey.survey_templates st INNER JOIN survey.survey_periods sp ON st.survey_id = sp.survey_id
			        JOIN designer.history h ON st.template_id = h.template_id

mappingId	mapping--1999601792
target		colsys:code-list/{id} a gsim-sum:CodeList ; rdfs:label {label}^^xsd:string ; gsim-sum:hasName-IA {label}^^xsd:string . 
source		SELECT * FROM designer.component

mappingId	tm-join--1496960379
target		colsys:questionnaire/{CHILD_t_id} :hasQ-Qu colsys:question/{PARENT_id} . 
source		SELECT CHILD.t_id AS CHILD_t_id, PARENT.id AS PARENT_id FROM (SELECT
			          t.id t_id,
			          t.name t_name,
			          s.id s_id,
			          s.name s_name,
			          c.id c_id,
			          c.label c_label
			        FROM
			          designer.template t JOIN designer.[section] s ON t.id = s.template_id
			          JOIN designer.component c ON s.id = c.section_id) CHILD, (SELECT * FROM designer.component) PARENT WHERE CHILD.s_id = PARENT.section_id

mappingId	tm-join--1096372310
target		<https://bps.go.id/metadata/software/questionnaire-designer/form-engine/agent-in-role/{CHILD_id}> :wasAssociatedWithAIR-A colsys:individual/{PARENT_id} . 
source		SELECT CHILD.id AS CHILD_id, PARENT.id AS PARENT_id FROM (SELECT
			           'QuestionnaireDesigner' AS pkg_id, *
			          FROM dbo.user_roles) CHILD, (SELECT * FROM dbo.users) PARENT WHERE CHILD.user_id = PARENT.id

mappingId	tm-join-666192648
