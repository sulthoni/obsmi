mappingId	mapping-1982680200
target		colsys:rule/validation/{v_id} a gsim-sum:Rule ; gsim-sum:hasValue-IA {expression}^^xsd:string . 
source		SELECT 
			        v.id v_id,
			        v.expression expression,
			        v.type v_type,
			        v.status v_status,
			        v.error_message v_error_message,
			        v.validation_combination_id v_validation_combination_id,
			        vsp.validation_id vsp_validation_id,
			        vsp.variable_id vsp_variable_id 
			      FROM 
			        ve.validation v JOIN ve.validation_self_parameter vsp ON v.id = vsp.validation_id

mappingId	mapping-952618005
target		colsys:category/history-type/{id} a gsim-sum:Category ; gsim-sum:hasName-IA "History Type - {name}"^^xsd:string . 
