source		SELECT CHILD.survey_id AS CHILD_survey_id, CHILD.survey_periode_id AS CHILD_survey_periode_id, PARENT.survey_id AS PARENT_survey_id, PARENT.survey_periode_id AS PARENT_survey_periode_id FROM (SELECT DISTINCT
