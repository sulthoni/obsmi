mappingId	mapping-1795970536
target		colsys:rule/validation-combination/{id} a gsim-sum:Rule ; gsim-sum:hasValue-IA {expression}^^xsd:string ; rdfs:label {vc_name}^^xsd:string ; gsim-sum:hasName-IA {vc_name}^^xsd:string . 
source		SELECT 
			        vc.id id,
			        vc.name vc_name,
			        vc.status vc_status,
			        v.id v_id,
			        v.expression expression,
			        v.type v_type,
			        v.status v_status,
			        v.error_message v_error_message,
			        vcp.validation_combination_id vcp_validation_combination_id,
			        vcp.variable_id vcp_variable_id
			      FROM 
			        ve.validation_combination vc
			        JOIN ve.validation v ON vc.id = v.validation_combination_id
			        JOIN ve.validation_combination_parameter vcp ON vc.id = vcp.validation_combination_id

