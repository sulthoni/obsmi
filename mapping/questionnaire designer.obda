mappingId	mapping-784877237
target		<https://bps.go.id/metadata/software/questionnaire-designer/form-engine/service-implementation/{fe_id}/version/{fer_version}> a cspa:ServiceImplementationDescription ; cspa:version {fer_version}^^xsd:string ; rdfs:label "Form Engine - {fe_name} - Version {fer_version}"^^xsd:string . 
