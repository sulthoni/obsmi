mappingId	mapping-1954150597
target		colsys:process-execution-log/{survey_id}/{survey_periode_id}/template-preview a :ProcessExecutionLog ; gsim-sum:hasExecutionLog "Preview Name: {tp_name}. Preview {tp_html}. Preview Template: {tp_template_id}. Preview Time: {tp_created_time}. Preview Update Time {tp_updated_time}."^^xsd:string . 
source		SELECT
			          st.survey_id survey_id,
			          sp.id survey_periode_id,
			          st.template_id questionnaire_id,
			          st.survey_template_name questionnaire_name,
			          st.template_version questionnaire_version,
			          st.validation_version validation_version,
			          st.created_at created_at,
			          st.updated_at updated_at,
			          tp.id tp_id,
			          tp.name tp_name,
			          tp.html tp_html,
			          tp.template_id tp_template_id,
			          tp.created_time tp_created_time,
			          tp.updated_time tp_updated_time
			      FROM 
			        survey.survey_templates st INNER JOIN survey.survey_periods sp ON st.survey_id = sp.survey_id
			        JOIN designer.template_preview tp ON st.template_id = tp.template_id

