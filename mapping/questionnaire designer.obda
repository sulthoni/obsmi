target		colsys:process-execution-log/{survey_id}/{survey_periode_id}/template-release a :ProcessExecutionLog ; gsim-sum:hasExecutionLog "Release Version: {tr_version}. Release Date: {tr_release_date}. Release Directory: {tr_release_dir}. Validation Version: {tr_validation_version}."^^xsd:string . 
