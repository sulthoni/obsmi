mappingId	tm-join-154452952
target		colsys:rule/validation/{CHILD_v_id} :usedbyValidationVa-V colsys:variable/{PARENT_id} . 
source		SELECT CHILD.v_id AS CHILD_v_id, PARENT.id AS PARENT_id FROM (SELECT 
			        v.id v_id,
			        v.expression expression,
			        v.type v_type,
			        v.status v_status,
			        v.error_message v_error_message,
			        v.validation_combination_id v_validation_combination_id,
			        vsp.validation_id vsp_validation_id,
			        vsp.variable_id vsp_variable_id 
			      FROM 
			        ve.validation v JOIN ve.validation_self_parameter vsp ON v.id = vsp.validation_id) CHILD, (SELECT * FROM ve.variable) PARENT WHERE CHILD.vsp_variable_id = PARENT.id

mappingId	tm-join--353224020
target		colsys:rule/validation/{CHILD_v_id} :combinedbyR-R colsys:rule/validation-combination/{PARENT_id} . 
source		SELECT CHILD.v_id AS CHILD_v_id, PARENT.id AS PARENT_id FROM (SELECT 
			        v.id v_id,
			        v.expression expression,
			        v.type v_type,
			        v.status v_status,
			        v.error_message v_error_message,
			        v.validation_combination_id v_validation_combination_id,
			        vsp.validation_id vsp_validation_id,
			        vsp.variable_id vsp_variable_id 
			      FROM 
			        ve.validation v JOIN ve.validation_self_parameter vsp ON v.id = vsp.validation_id) CHILD, (SELECT 
			        vc.id id,
			        vc.name vc_name,
			        vc.status vc_status,
			        v.id v_id,
			        v.expression expression,
			        v.type v_type,
			        v.status v_status,
			        v.error_message v_error_message,
			        vcp.validation_combination_id vcp_validation_combination_id,
			        vcp.variable_id vcp_variable_id
			      FROM 
			        ve.validation_combination vc
			        JOIN ve.validation v ON vc.id = v.validation_combination_id
			        JOIN ve.validation_combination_parameter vcp ON vc.id = vcp.validation_combination_id) PARENT WHERE CHILD.v_validation_combination_id = PARENT.id

mappingId	tm-join--160566798
target		colsys:data-structure-component/design-collection/table/{CHILD_etab_id} :hasDSC-DSC colsys:data-structure-component/design-collection/column/{PARENT_ec_id} . 
source		SELECT CHILD.etab_id AS CHILD_etab_id, PARENT.ec_id AS PARENT_ec_id FROM (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      designer.extraction_template et  
			      JOIN designer.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN designer.extraction_column ec ON etab.id = ec.extraction_table_id) CHILD, (SELECT
			      et.id et_id,
			      et.template_id et_template_id,
			      et.template_version et_template_version,
			      et.validation_version et_validation_version,
			      et.created_at et_created_at,
			      et.created_by et_created_by,
			      et.is_active et_is_active,
			      etab.id etab_id,
			      etab.extraction_template_id etab_extraction_template_id,
			      etab.name etab_name,
			      etab.roster_level etab_roster_level,
			      ec.id ec_id,
			      ec.extraction_table_id ec_extraction_table_id,
			      ec.name ec_name,
			      ec.data_type ec_data_type,
			      ec.from_template ec_from_template,
			      ec.pk ec_pk,
			      ec.label ec_label,
			      ec.question_type_id ec_question_type_id,
			      ec.position ec_position
			    FROM
			      designer.extraction_template et  
			      JOIN designer.extraction_table etab ON et.id = etab.extraction_template_id 
			      JOIN designer.extraction_column ec ON etab.id = ec.extraction_table_id) PARENT WHERE CHILD.etab_id = PARENT.ec_extraction_table_id

